# Only what the image needs enters the build context (SECURITY-SPEC
# "Container image"): everything is left out, then the runtime requirements and
# the application code are let back in.
*
!requirements.txt
!src/

# Within src/, leave out the tests, caches and any .env or Git files.
src/**/tests/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.env
**/.env.*
**/.git/
